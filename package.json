{
  "name": "pizza-zio-franchise-landing",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:server && npm run test:ui",
    "test:e2e": "playwright test",
    "test:online": "playwright test --config playwright.online.config.ts",
    "test:integration": "node tests/integration/run.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:server": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx --test tests/*.test.tsx",
    "build:design": "node scripts/build-design-preview.mjs"
  },
  "dependencies": {
    "google-auth-library": "11.3.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.0.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^27.0.0",
    "postcss": "8.5.32",
    "tailwindcss": "^3.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "minimatch@^10.2.0": "11.0.1"
  }
}
