# Server-only configuration. Never prefix these variables with NEXT_PUBLIC_.
# Keep collection disabled until data/launchConfig.ts and delivery are validated.
LEAD_INTAKE_ENABLED=false
LEAD_ALLOWED_ORIGIN=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LEAD_HASH_SECRET=

# Alternative Google Sheets receiver, private and server-only.
LEAD_DESTINATION=webhook
LEAD_SHEET_ID=
LEAD_SHEET_TAB_ID=
LEAD_SHEET_CLIENT_EMAIL=
LEAD_SHEET_PRIVATE_KEY=
PIZZA_ZIO_VISUAL_PACK=0
LEAD_INDEXING_ENABLED=false
